digraph domain {
  rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=11, labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.7];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  graph [nodesep=0.25, ranksep=0.9];
  label=<<B>Доменна модель: сутності, служби, винятки</B><BR/><FONT POINT-SIZE="10">схему згенеровано з коду: 10.10.2026</FONT>>;
  subgraph "cluster_domain" {
    label="Domain"; style="rounded,filled"; fillcolor="#FFF3D640"; color="#B8860B"; fontname="DejaVu Sans";
    "Disease" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«entity»</I></FONT></TD></TR><TR><TD><B>Disease</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">disease_id: UUID<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>drug_count: int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "DocumentValidator" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«domain service»</I></FONT></TD></TR><TR><TD><B>DocumentValidator</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">validate()<BR ALIGN="LEFT"/>ensure_valid()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "DomainError" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«exception»</I></FONT></TD></TR><TR><TD><B>DomainError</B></TD></TR></TABLE>>];
    "Medicine" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«entity»</I></FONT></TD></TR><TR><TD><B>Medicine</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">medicine_id: UUID<BR ALIGN="LEFT"/>source_id: int<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>therapeutic_class: str<BR ALIGN="LEFT"/>is_habit_forming: bool<BR ALIGN="LEFT"/>is_prescription: bool<BR ALIGN="LEFT"/>manufacturer: str<BR ALIGN="LEFT"/>price: float<BR ALIGN="LEFT"/>chemical_class: str | None<BR ALIGN="LEFT"/>action_class: str | None<BR ALIGN="LEFT"/>uses: list[str]<BR ALIGN="LEFT"/>side_effects: list[str]<BR ALIGN="LEFT"/>substitutes: list[str]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "MedicineNotFoundError" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«exception»</I></FONT></TD></TR><TR><TD><B>MedicineNotFoundError</B></TD></TR></TABLE>>];
    "QueryNormalizer" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«domain service»</I></FONT></TD></TR><TR><TD><B>QueryNormalizer</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">normalize()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "SearchDocument" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«entity»</I></FONT></TD></TR><TR><TD><B>SearchDocument</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">medicine_id: UUID<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>full_description: str<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "SearchHit" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«entity»</I></FONT></TD></TR><TR><TD><B>SearchHit</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">medicine_id: UUID<BR ALIGN="LEFT"/>score: float<BR ALIGN="LEFT"/>snippets: list[str]<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "SearchLogEntry" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«entity»</I></FONT></TD></TR><TR><TD><B>SearchLogEntry</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">query_id: UUID<BR ALIGN="LEFT"/>raw_query: str<BR ALIGN="LEFT"/>normalized_query: str<BR ALIGN="LEFT"/>results_count: int<BR ALIGN="LEFT"/>cache_hit: bool<BR ALIGN="LEFT"/>latency_ms: int<BR ALIGN="LEFT"/>created_at: datetime<BR ALIGN="LEFT"/></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">status()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "ShardKey" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«value object»</I></FONT></TD></TR><TR><TD><B>ShardKey</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">therapeutic_class: str<BR ALIGN="LEFT"/>medicine_id: UUID<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "ShardKeyService" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«domain service»</I></FONT></TD></TR><TR><TD><B>ShardKeyService</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">compute()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "Symptom" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«entity»</I></FONT></TD></TR><TR><TD><B>Symptom</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">symptom_id: UUID<BR ALIGN="LEFT"/>name: str<BR ALIGN="LEFT"/>drug_count: int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "ValidationError" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«exception»</I></FONT></TD></TR><TR><TD><B>ValidationError</B></TD></TR></TABLE>>];
  }
  "DocumentValidator" -> "Medicine" [style=dotted, arrowhead=open, color="#999999"];
  "MedicineNotFoundError" -> "DomainError" [style=dashed, arrowhead=empty];
  "ShardKeyService" -> "Medicine" [style=dotted, arrowhead=open, color="#999999"];
  "ShardKeyService" -> "ShardKey" [style=dotted, arrowhead=open, color="#999999"];
  "ValidationError" -> "DomainError" [style=dashed, arrowhead=empty];
}
