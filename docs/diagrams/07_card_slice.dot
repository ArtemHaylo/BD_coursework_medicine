digraph card {
  rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=11, labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.7];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  label=<<B>Зріз «Картка препарату»: Controller → вхідний порт → Handler → Repository → Adapter</B><BR/><FONT POINT-SIZE="10">схему згенеровано з коду: 10.10.2026</FONT><BR/><FONT POINT-SIZE="9">суцільна стрілка: залежність через конструктор; пунктир із порожнім трикутником: реалізація порту; крапки: використання DTO / створення в Container</FONT>>;
  subgraph "cluster_presentation" {
    label="Presentation"; style="rounded,filled"; fillcolor="#E3ECFB40"; color="#2F5DA8"; fontname="DejaVu Sans";
    "MedicineController" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3ECFB" COLOR="#2F5DA8"><TR><TD><FONT POINT-SIZE="9"><I>«controller»</I></FONT></TD></TR><TR><TD><B>MedicineController</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">list_medicines()<BR ALIGN="LEFT"/>get_card()<BR ALIGN="LEFT"/>create()<BR ALIGN="LEFT"/>update()<BR ALIGN="LEFT"/>delete()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_application" {
    label="Application"; style="rounded,filled"; fillcolor="#E2F3E440"; color="#2E7D32"; fontname="DejaVu Sans";
    "GetMedicineCard" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«inbound port»</I></FONT></TD></TR><TR><TD><B>GetMedicineCard</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">handle()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "GetMedicineCardHandler" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«handler»</I></FONT></TD></TR><TR><TD><B>GetMedicineCardHandler</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">handle()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "MedicineCard" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«DTO»</I></FONT></TD></TR><TR><TD><B>MedicineCard</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_domain" {
    label="Domain"; style="rounded,filled"; fillcolor="#FFF3D640"; color="#B8860B"; fontname="DejaVu Sans";
    "CacheStore" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«outbound port»</I></FONT></TD></TR><TR><TD><B>CacheStore</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">get()<BR ALIGN="LEFT"/>set()<BR ALIGN="LEFT"/>delete()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "DocumentRepository" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«outbound port»</I></FONT></TD></TR><TR><TD><B>DocumentRepository</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">create()<BR ALIGN="LEFT"/>create_many()<BR ALIGN="LEFT"/>get_by_id()<BR ALIGN="LEFT"/>by_ids()<BR ALIGN="LEFT"/>find()<BR ALIGN="LEFT"/>count()<BR ALIGN="LEFT"/>top_side_effects()<BR ALIGN="LEFT"/>update()<BR ALIGN="LEFT"/>delete()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_infrastructure" {
    label="Infrastructure"; style="rounded,filled"; fillcolor="#FBE3E340"; color="#B23A3A"; fontname="DejaVu Sans";
    "MongoDocumentAdapter" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE3E3" COLOR="#B23A3A"><TR><TD><FONT POINT-SIZE="9"><I>«adapter»</I></FONT></TD></TR><TR><TD><B>MongoDocumentAdapter</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">ensure_indexes()<BR ALIGN="LEFT"/>ensure_sharding()<BR ALIGN="LEFT"/>create()<BR ALIGN="LEFT"/>create_many()<BR ALIGN="LEFT"/>get_by_id()<BR ALIGN="LEFT"/>by_ids()<BR ALIGN="LEFT"/>find()<BR ALIGN="LEFT"/>count()<BR ALIGN="LEFT"/>top_side_effects()<BR ALIGN="LEFT"/>update()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    "RedisCacheAdapter" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE3E3" COLOR="#B23A3A"><TR><TD><FONT POINT-SIZE="9"><I>«adapter»</I></FONT></TD></TR><TR><TD><B>RedisCacheAdapter</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="9">get()<BR ALIGN="LEFT"/>set()<BR ALIGN="LEFT"/>delete()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
  }
  subgraph "cluster_config" {
    label="Композиційний корінь"; style="rounded,filled"; fillcolor="#F7D9D940"; color="#8E2B2B"; fontname="DejaVu Sans";
    "Container" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F7D9D9" COLOR="#8E2B2B"><TR><TD><FONT POINT-SIZE="9"><I>«composition root»</I></FONT></TD></TR><TR><TD><B>Container</B></TD></TR></TABLE>>];
  }
  "Container" -> "MongoDocumentAdapter" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "Container" -> "RedisCacheAdapter" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "Container" -> "GetMedicineCardHandler" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "GetMedicineCard" -> "MedicineCard" [style=dotted, arrowhead=open, color="#999999"];
  "GetMedicineCardHandler" -> "GetMedicineCard" [style=dashed, arrowhead=empty];
  "GetMedicineCardHandler" -> "DocumentRepository" [arrowhead=vee];
  "GetMedicineCardHandler" -> "CacheStore" [arrowhead=vee];
  "GetMedicineCardHandler" -> "MedicineCard" [style=dotted, arrowhead=open, color="#999999"];
  "MedicineController" -> "GetMedicineCard" [arrowhead=vee];
  "MedicineController" -> "MedicineCard" [style=dotted, arrowhead=open, color="#999999"];
  "MongoDocumentAdapter" -> "DocumentRepository" [style=dashed, arrowhead=empty];
  "RedisCacheAdapter" -> "CacheStore" [style=dashed, arrowhead=empty];
}
