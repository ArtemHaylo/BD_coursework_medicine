digraph search {
  rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=11, labelloc=t, pad=0.3, nodesep=0.35, ranksep=0.7];
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=9, color="#555555"];
  label=<<B>Зріз «Пошук препаратів» (шлях запитів)</B><BR/><FONT POINT-SIZE="10">схему згенеровано з коду: 10.10.2026</FONT><BR/><FONT POINT-SIZE="9">суцільна стрілка: залежність через конструктор; пунктир із порожнім трикутником: реалізація порту; крапки: використання DTO / створення в Container</FONT>>;
  subgraph "cluster_presentation" {
    label="Presentation"; style="rounded,filled"; fillcolor="#E3ECFB40"; color="#2F5DA8"; fontname="DejaVu Sans";
    "SearchController" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E3ECFB" COLOR="#2F5DA8"><TR><TD><FONT POINT-SIZE="9"><I>«controller»</I></FONT></TD></TR><TR><TD><B>SearchController</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_application" {
    label="Application"; style="rounded,filled"; fillcolor="#E2F3E440"; color="#2E7D32"; fontname="DejaVu Sans";
    "SearchMedicines" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«inbound port»</I></FONT></TD></TR><TR><TD><B>SearchMedicines</B></TD></TR></TABLE>>];
    "SearchMedicinesHandler" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«handler»</I></FONT></TD></TR><TR><TD><B>SearchMedicinesHandler</B></TD></TR></TABLE>>];
    "SearchQuery" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«DTO»</I></FONT></TD></TR><TR><TD><B>SearchQuery</B></TD></TR></TABLE>>];
    "SearchResult" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#E2F3E4" COLOR="#2E7D32"><TR><TD><FONT POINT-SIZE="9"><I>«DTO»</I></FONT></TD></TR><TR><TD><B>SearchResult</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_domain" {
    label="Domain"; style="rounded,filled"; fillcolor="#FFF3D640"; color="#B8860B"; fontname="DejaVu Sans";
    "CacheStore" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«outbound port»</I></FONT></TD></TR><TR><TD><B>CacheStore</B></TD></TR></TABLE>>];
    "DocumentRepository" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«outbound port»</I></FONT></TD></TR><TR><TD><B>DocumentRepository</B></TD></TR></TABLE>>];
    "MetricsSink" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«outbound port»</I></FONT></TD></TR><TR><TD><B>MetricsSink</B></TD></TR></TABLE>>];
    "QueryNormalizer" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«domain service»</I></FONT></TD></TR><TR><TD><B>QueryNormalizer</B></TD></TR></TABLE>>];
    "SearchIndex" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFF3D6" COLOR="#B8860B"><TR><TD><FONT POINT-SIZE="9"><I>«outbound port»</I></FONT></TD></TR><TR><TD><B>SearchIndex</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_infrastructure" {
    label="Infrastructure"; style="rounded,filled"; fillcolor="#FBE3E340"; color="#B23A3A"; fontname="DejaVu Sans";
    "MongoDocumentAdapter" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE3E3" COLOR="#B23A3A"><TR><TD><FONT POINT-SIZE="9"><I>«adapter»</I></FONT></TD></TR><TR><TD><B>MongoDocumentAdapter</B></TD></TR></TABLE>>];
    "MongoMetricsAdapter" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE3E3" COLOR="#B23A3A"><TR><TD><FONT POINT-SIZE="9"><I>«adapter»</I></FONT></TD></TR><TR><TD><B>MongoMetricsAdapter</B></TD></TR></TABLE>>];
    "RedisCacheAdapter" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE3E3" COLOR="#B23A3A"><TR><TD><FONT POINT-SIZE="9"><I>«adapter»</I></FONT></TD></TR><TR><TD><B>RedisCacheAdapter</B></TD></TR></TABLE>>];
    "SearchIndexAdapter" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FBE3E3" COLOR="#B23A3A"><TR><TD><FONT POINT-SIZE="9"><I>«adapter»</I></FONT></TD></TR><TR><TD><B>SearchIndexAdapter</B></TD></TR></TABLE>>];
  }
  subgraph "cluster_config" {
    label="Композиційний корінь"; style="rounded,filled"; fillcolor="#F7D9D940"; color="#8E2B2B"; fontname="DejaVu Sans";
    "Container" [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F7D9D9" COLOR="#8E2B2B"><TR><TD><FONT POINT-SIZE="9"><I>«composition root»</I></FONT></TD></TR><TR><TD><B>Container</B></TD></TR></TABLE>>];
  }
  "Container" -> "MongoDocumentAdapter" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "Container" -> "SearchIndexAdapter" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "Container" -> "RedisCacheAdapter" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "Container" -> "MongoMetricsAdapter" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "Container" -> "SearchMedicinesHandler" [style=dotted, arrowhead=open, color="#B23A3A", label="створює"];
  "MongoDocumentAdapter" -> "DocumentRepository" [style=dashed, arrowhead=empty];
  "MongoMetricsAdapter" -> "MetricsSink" [style=dashed, arrowhead=empty];
  "RedisCacheAdapter" -> "CacheStore" [style=dashed, arrowhead=empty];
  "SearchController" -> "SearchMedicines" [arrowhead=vee];
  "SearchController" -> "SearchResult" [style=dotted, arrowhead=open, color="#999999"];
  "SearchIndexAdapter" -> "SearchIndex" [style=dashed, arrowhead=empty];
  "SearchMedicines" -> "SearchQuery" [style=dotted, arrowhead=open, color="#999999"];
  "SearchMedicines" -> "SearchResult" [style=dotted, arrowhead=open, color="#999999"];
  "SearchMedicinesHandler" -> "SearchMedicines" [style=dashed, arrowhead=empty];
  "SearchMedicinesHandler" -> "SearchIndex" [arrowhead=vee];
  "SearchMedicinesHandler" -> "CacheStore" [arrowhead=vee];
  "SearchMedicinesHandler" -> "DocumentRepository" [arrowhead=vee];
  "SearchMedicinesHandler" -> "MetricsSink" [arrowhead=vee];
  "SearchMedicinesHandler" -> "QueryNormalizer" [arrowhead=vee];
  "SearchMedicinesHandler" -> "SearchQuery" [style=dotted, arrowhead=open, color="#999999"];
  "SearchMedicinesHandler" -> "SearchResult" [style=dotted, arrowhead=open, color="#999999"];
}
