digraph usecases {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=16, nodesep=0.2, ranksep=1.0, label=<<B>Зв'язки між класами (станом на 10.10.2026)</B><BR/><FONT POINT-SIZE="12">Колонки зліва направо: Presentation і процеси → Application (вхідний порт ⇐ обробник) → Domain (вихідні порти) → Infrastructure (адаптери) → сховища<BR/>Червоний пунктир з порожнім трикутником: адаптер реалізує порт; фіолетовий пунктир: процес напряму використовує вихідний порт</FONT>>, labelloc=t, splines=spline];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=13, margin="0.10,0.05"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#666666", arrowsize=0.7];
  { rank=same; "AnaloguesController"; "MedicineController"; "RateController"; "SearchController"; "StatsStreamController"; "IngestWorker"; "LoadGenerator"; }
  "AnaloguesController" [fillcolor="#e8f0fe"];
  "MedicineController" [fillcolor="#e8f0fe"];
  "RateController" [fillcolor="#e8f0fe"];
  "SearchController" [fillcolor="#e8f0fe"];
  "StatsStreamController" [fillcolor="#e8f0fe"];
  "IngestWorker" [fillcolor="#e8f0fe"];
  "LoadGenerator" [fillcolor="#e8f0fe"];
  { rank=same; "ConfigureRate"; "CreateMedicine"; "DeleteMedicine"; "GetAnalogues"; "GetMedicineCard"; "GetStats"; "IngestDocument"; "ListMedicines"; "SearchMedicines"; "UpdateMedicine"; }
  "ConfigureRate" [label="ConfigureRate\n⇐ ConfigureRateHandler", fillcolor="#e6f4ea"];
  "CreateMedicine" [label="CreateMedicine\n⇐ CreateMedicineHandler\nслужби: DocumentValidator", fillcolor="#e6f4ea"];
  "DeleteMedicine" [label="DeleteMedicine\n⇐ DeleteMedicineHandler", fillcolor="#e6f4ea"];
  "GetAnalogues" [label="GetAnalogues\n⇐ GetAnaloguesHandler", fillcolor="#e6f4ea"];
  "GetMedicineCard" [label="GetMedicineCard\n⇐ GetMedicineCardHandler", fillcolor="#e6f4ea"];
  "GetStats" [label="GetStats\n⇐ GetStatsHandler", fillcolor="#e6f4ea"];
  "IngestDocument" [label="IngestDocument\n⇐ IngestDocumentHandler\nслужби: DocumentValidator, ShardKeyService", fillcolor="#e6f4ea"];
  "ListMedicines" [label="ListMedicines\n⇐ ListMedicinesHandler", fillcolor="#e6f4ea"];
  "SearchMedicines" [label="SearchMedicines\n⇐ SearchMedicinesHandler\nслужби: QueryNormalizer", fillcolor="#e6f4ea"];
  "UpdateMedicine" [label="UpdateMedicine\n⇐ UpdateMedicineHandler", fillcolor="#e6f4ea"];
  { rank=same; "CacheStore"; "DiseaseRepository"; "DocumentRepository"; "GraphRepository"; "MetricsSink"; "QueuePublisher"; "SearchIndex"; "SymptomRepository"; }
  "CacheStore" [fillcolor="#fff4e0"];
  "DiseaseRepository" [fillcolor="#fff4e0"];
  "DocumentRepository" [fillcolor="#fff4e0"];
  "GraphRepository" [fillcolor="#fff4e0"];
  "MetricsSink" [fillcolor="#fff4e0"];
  "QueuePublisher" [fillcolor="#fff4e0"];
  "SearchIndex" [fillcolor="#fff4e0"];
  "SymptomRepository" [fillcolor="#fff4e0"];
  { rank=same; "MongoDocumentAdapter"; "MongoMetricsAdapter"; "Neo4jDiseaseAdapter"; "Neo4jGraphAdapter"; "Neo4jSymptomAdapter"; "QueueAdapter"; "RedisCacheAdapter"; "SearchIndexAdapter"; }
  "MongoDocumentAdapter" [fillcolor="#fce8e6"];
  "MongoMetricsAdapter" [fillcolor="#fce8e6"];
  "Neo4jDiseaseAdapter" [fillcolor="#fce8e6"];
  "Neo4jGraphAdapter" [fillcolor="#fce8e6"];
  "Neo4jSymptomAdapter" [fillcolor="#fce8e6"];
  "QueueAdapter" [fillcolor="#fce8e6"];
  "RedisCacheAdapter" [fillcolor="#fce8e6"];
  "SearchIndexAdapter" [fillcolor="#fce8e6"];
  { rank=same; "Elasticsearch"; "MongoDB"; "Neo4j"; "RabbitMQ"; "Redis"; }
  "Elasticsearch" [fillcolor="#e8eaed", shape=cylinder];
  "MongoDB" [fillcolor="#e8eaed", shape=cylinder];
  "Neo4j" [fillcolor="#e8eaed", shape=cylinder];
  "RabbitMQ" [fillcolor="#e8eaed", shape=cylinder];
  "Redis" [fillcolor="#e8eaed", shape=cylinder];
